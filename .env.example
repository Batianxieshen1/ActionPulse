# OpenAI:  AP_LLM_BASE_URL=https://api.openai.com/v1
# Gemini:  AP_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Ollama:  AP_LLM_BASE_URL=http://127.0.0.1:11434/v1
#
# AP_LLM_BASE_URL=
# AP_LLM_API_KEY=
# AP_LLM_MODEL=

